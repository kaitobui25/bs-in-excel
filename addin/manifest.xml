<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="ContentApp">
  <Id>db6c0ed5-0bcb-459e-b6da-7ff47618d330</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>BS in Excel</ProviderName>
  <DefaultLocale>vi-VN</DefaultLocale>
  <DisplayName DefaultValue="Text Browser"/>
  <Description DefaultValue="Minimal text-only browser embedded in Excel."/>
  <IconUrl DefaultValue="https://localhost:3010/icon.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:3010/icon.png"/>
  <SupportUrl DefaultValue="https://github.com/kaitobui25/bs-in-excel"/>
  <Hosts><Host Name="Workbook"/></Hosts>
  <Requirements><Sets DefaultMinVersion="1.1"><Set Name="ExcelApi" MinVersion="1.1"/></Sets></Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3010/index.html"/>
    <RequestedWidth>950</RequestedWidth>
    <RequestedHeight>560</RequestedHeight>
  </DefaultSettings>
  <Permissions>Restricted</Permissions>
</OfficeApp>
